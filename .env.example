# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA DE CONTABILIDADE PESSOAL
# Copie este arquivo para .env e customize as variáveis conforme seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Portas e Hospedagem dos Serviços
# ------------------------------------------------------------------------------
# Porta de escuta do backend (API Express)
PORT=3000
API_PORT=3000

# Porta de acesso público ao frontend (Nginx Web Server)
FRONTEND_PORT=80

# URL base utilizada pela API para links e uploads
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL (Local Docker ou Remoto)
# ------------------------------------------------------------------------------
# Configurações do container postgres no docker-compose
POSTGRES_DB=contabilidade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_mude_essa_senha_em_producao
POSTGRES_PORT=5432

# Credenciais de conexão utilizadas pela API para falar com o banco
# No Docker Compose, o host do banco de dados é o nome do serviço: postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres_mude_essa_senha_em_producao
DB_NAME=contabilidade

# SSL no PostgreSQL:
# - Defina como false para containers locais e auto-hospedados (padrão)
# - Defina como true caso aponte para serviços em nuvem (Neon, Supabase, AWS RDS)
DB_SSL=false

# (Opcional) String de conexão direta (substitui DB_HOST, DB_USER, etc., se preenchida)
# DATABASE_URL=postgresql://postgres:postgres_mude_essa_senha_em_producao@postgres:5432/contabilidade

# ------------------------------------------------------------------------------
# 3. Segurança e Autenticação
# ------------------------------------------------------------------------------
# Segredo para assinatura dos tokens JWT (Use uma chave forte e aleatória em produção)
JWT_SECRET=super_secret_jwt_token_altere_para_uma_chave_segura_em_producao

# ------------------------------------------------------------------------------
# 4. Inteligência Artificial / LLM (Opcional - Groq Cloud)
# ------------------------------------------------------------------------------
# Chave de API da Groq para categorização e leitura de notas fiscais
GROQ_API_KEY=

# Modelos recomendados para inferência de texto e visão
AI_TEXT_MODEL=openai/gpt-oss-20b
AI_VISION_MODEL=meta-llama/llama-4-scenic-12b

